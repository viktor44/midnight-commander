Translate curses' shifted-key codes, so Shift+Up/Down mark files in a panel.

Shift+Up and Shift+Down did nothing in the file panels (and Shift+Left,
Shift+Right, Shift+Home, Shift+End, Shift+Ins, Shift+Del and Shift+PgUp/PgDn
were equally dead).

mc expects those keys as the plain key code plus its own KEY_M_SHIFT flag,
which it normally builds itself by decoding the escape sequences in its own
key table in lib/tty/key.c. But the xterm entries in ncurses 6.x, which this
build compiles and ships, describe each of them as a capability of its own:
kri=\E[1;2A, kind=\E[1;2B, kLFT, kRIT, kHOM, kEND, kIC, kDC, kNXT and kPRV.
With keypad mode on, ncurses recognises the sequence first and returns
KEY_SR, KEY_SF, KEY_SLEFT and so on, codes mc has no idea about, so the key
is dropped before mc's own table ever sees it.

Turn those codes back into the plain key with the Shift modifier set, in
correct_key_code() next to the other key fix-ups. Each is guarded by #ifdef
because the slang screen library does not define them.

--- a/lib/tty/key.c
+++ b/lib/tty/key.c
@@ -1022,6 +1022,64 @@
 
 /* --------------------------------------------------------------------------------------------- */
 /**
+ * Split a curses "shifted key" code into the plain key and the Shift modifier.
+ *
+ * Terminfo describes Shift+Up, Shift+Down, Shift+Left and so on as capabilities of their own
+ * (kri, kind, kLFT, ...), and ncurses reports them as KEY_SR, KEY_SF, KEY_SLEFT, ... instead of
+ * leaving the escape sequence for mc's own key tree. Current xterm entries all carry them, so
+ * mc has to translate them itself or the keys do nothing.
+ *
+ * @return the unshifted key code, or 0 if @c is not a shifted key code
+ */
+
+static unsigned int
+unshift_curses_key (unsigned int c)
+{
+#ifdef KEY_SR
+    if (c == (unsigned int) KEY_SR)
+        return KEY_UP;
+#endif
+#ifdef KEY_SF
+    if (c == (unsigned int) KEY_SF)
+        return KEY_DOWN;
+#endif
+#ifdef KEY_SLEFT
+    if (c == (unsigned int) KEY_SLEFT)
+        return KEY_LEFT;
+#endif
+#ifdef KEY_SRIGHT
+    if (c == (unsigned int) KEY_SRIGHT)
+        return KEY_RIGHT;
+#endif
+#ifdef KEY_SHOME
+    if (c == (unsigned int) KEY_SHOME)
+        return KEY_HOME;
+#endif
+#ifdef KEY_SEND
+    if (c == (unsigned int) KEY_SEND)
+        return KEY_END;
+#endif
+#ifdef KEY_SIC
+    if (c == (unsigned int) KEY_SIC)
+        return KEY_IC;
+#endif
+#ifdef KEY_SDC
+    if (c == (unsigned int) KEY_SDC)
+        return KEY_DC;
+#endif
+#ifdef KEY_SNEXT
+    if (c == (unsigned int) KEY_SNEXT)
+        return KEY_NPAGE;
+#endif
+#ifdef KEY_SPREVIOUS
+    if (c == (unsigned int) KEY_SPREVIOUS)
+        return KEY_PPAGE;
+#endif
+    return 0;
+}
+
+/* --------------------------------------------------------------------------------------------- */
+/**
  * Tell whether the terminfo entry numbers the shifted function keys the xterm way.
  *
  * mc reads KEY_F (11) .. KEY_F (20) as Shift+F1 .. Shift+F10, the convention of the old
@@ -1088,6 +1146,18 @@
     if (c == KEY_F (0))
         c = KEY_F (10);
 
+    /* Shift+arrows and the other shifted keys that terminfo has capabilities for */
+    {
+        unsigned int plain;
+
+        plain = unshift_curses_key (c);
+        if (plain != 0)
+        {
+            c = plain;
+            mod |= KEY_M_SHIFT;
+        }
+    }
+
