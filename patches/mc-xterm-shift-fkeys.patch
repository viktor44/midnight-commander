Map Shift+F1..F12 to the right keys on terminals with an xterm-style terminfo.

Shift+F3 acted as Shift+F5, Shift+F4 as Shift+F6, and Shift+F5 did nothing
useful: every shifted function key came out two places too high.

mc reads the curses key codes KEY_F(11)..KEY_F(20) as Shift+F1..Shift+F10.
That is the convention of the old termcap/rxvt entries, where kf11 and kf12
are F11 and F12 and kf13 is Shift+F3. Current xterm entries (the xterm+pcf2
building block in ncurses 6.x, which this build compiles and ships) number
them differently: kf13..kf24 are Shift+F1..Shift+F12, kf13 being "\E[1;2P".
ncurses recognises those sequences itself and hands mc KEY_F(13) for
Shift+F1, which mc then treats as Shift+F3.

Tell the two apart by looking at kf13 itself, and only when it is the xterm
Shift+F1 sequence renumber kf13..kf24 to Shift+F1..Shift+F12. Terminals whose
terminfo still follows the old convention are left alone. Shift+F11 and
Shift+F12 have no F(n+10) slot, so they come out as Shift with KEY_F(11) and
KEY_F(12), like the other modified function keys.

--- a/lib/tty/key.c
+++ b/lib/tty/key.c
@@ -1021,6 +1021,35 @@
 }
 
 /* --------------------------------------------------------------------------------------------- */
+/**
+ * Tell whether the terminfo entry numbers the shifted function keys the xterm way.
+ *
+ * mc reads KEY_F (11) .. KEY_F (20) as Shift+F1 .. Shift+F10, the convention of the old
+ * termcap/rxvt entries, where kf11 = F11, kf12 = F12 and kf13 = Shift+F3. Current xterm
+ * entries (xterm+pcf2 in ncurses 6.x) instead make kf13 .. kf24 Shift+F1 .. Shift+F12, with
+ * kf13 = "\E[1;2P". Taken at face value every Shift+Fn then acts as Shift+F(n+2).
+ */
+
+static gboolean
+shifted_fkeys_xterm_style (void)
+{
+    static int cached = -1;
+
+    if (cached < 0)
+    {
+        const char *kf13;
+
+        /* "F3" is the termcap name of kf13 */
+        kf13 = tty_tgetstr ("F3");
+        cached = (kf13 != NULL && kf13 != (const char *) -1
+                  && (strcmp (kf13, ESC_STR "[1;2P") == 0
+                      || strcmp (kf13, ESC_STR "O2P") == 0)) ? 1 : 0;
+    }
+
+    return (cached != 0);
+}
+
+/* --------------------------------------------------------------------------------------------- */
 /* Apply corrections for the keycode generated in get_key_code() */
 
 static int
@@ -1131,6 +1160,20 @@
     if (c >= KEY_F (1) && c <= KEY_F (20))
         mod &= ~KEY_M_SHIFT;
 
+    /* kf13 .. kf24 are Shift+F1 .. Shift+F12 on xterm-like terminals, not F13 .. F24 */
+    if (c >= KEY_F (13) && c <= KEY_F (24) && shifted_fkeys_xterm_style ())
+    {
+        unsigned int n = c - KEY_F (12);        /* number of the function key, 1..12 */
+
+        if (n <= 10)
+            c = KEY_F (10 + n);
+        else
+        {
+            c = KEY_F (n);
+            mod |= KEY_M_SHIFT;
+        }
+    }
+
     if (!mc_global.tty.alternate_plus_minus)
         switch (c)
         {
